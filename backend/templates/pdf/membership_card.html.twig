<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        @page { margin: 0; }
        html, body { background-color: #0E2A47; }
        body {
            margin: 0;
            font-family: 'DejaVu Sans', sans-serif;
        }
        /* Dompdf ignores box-sizing: width/height exclude the padding, so they
           are the page size (243pt x 153pt) minus the padding. Any overflow
           pushes the content onto a second page. */
        .card {
            width: 223pt;
            height: 137pt;
            padding: 8pt 10pt;
            overflow: hidden;
            background-color: #0E2A47;
            color: #FFFFFF;
        }

        table { border-collapse: collapse; width: 100%; }
        td { vertical-align: middle; padding: 0; }

        /* Header: logo + association name, gold divider underneath */
        .header td { vertical-align: middle; }
        .logo-cell { width: 28pt; }
        .logo-cell img {
            width: 24pt;
            height: 24pt;
            border-radius: 50%;
            border: 1.4pt solid #F2B705;
        }
        .assoc-cell { padding-left: 7pt; }
        .assoc-name {
            font-size: 11pt;
            font-weight: bold;
            letter-spacing: 0.3pt;
        }
        .assoc-tagline {
            font-size: 6.5pt;
            color: #F2B705;
            text-transform: uppercase;
            letter-spacing: 0.6pt;
            margin-top: 1pt;
        }
        .divider {
            height: 1.2pt;
            background: #F2B705;
            margin: 4pt 0 5pt 0;
            width: 100%;
            font-size: 0;
            line-height: 0;
        }

        /* Body: identity block + QR block */
        .identity-cell { width: 148pt; }
        .name {
            font-size: 12pt;
            font-weight: bold;
            line-height: 1.1;
        }
        .name-long { font-size: 10pt; }
        .member-since {
            font-size: 6.5pt;
            color: #E5E9F0;
            margin-top: 1pt;
        }
        .field-label {
            font-size: 6pt;
            text-transform: uppercase;
            letter-spacing: 0.5pt;
            color: #F2B705;
            margin-top: 4pt;
        }
        .field-value {
            font-size: 9pt;
            font-weight: bold;
            letter-spacing: 0.4pt;
        }
        .validity {
            font-size: 7pt;
            color: #E5E9F0;
            margin-top: 4pt;
            white-space: nowrap;
        }
        .validity strong { color: #FFFFFF; }

        .qr-cell { width: 77pt; text-align: center; }
        .qr-box {
            display: inline-block;
            background: #FFFFFF;
            padding: 3pt;
            border-radius: 4pt;
        }
        .qr-box img { width: 58pt; height: 58pt; }
        .qr-caption {
            font-size: 5.3pt;
            color: #E5E9F0;
            margin-top: 3pt;
            width: 70pt;
        }
    </style>
</head>
<body>
    <div class="card">
        <table class="header">
            <tr>
                <td class="logo-cell">
                    {% if logoDataUri %}<img src="{{ logoDataUri }}" alt="Logo">{% endif %}
                </td>
                <td class="assoc-cell">
                    <div class="assoc-name">C.J.O.M.M</div>
                    <div class="assoc-tagline">Carte d'adh&eacute;rent officielle</div>
                </td>
            </tr>
        </table>

        <div class="divider">&nbsp;</div>

        <table>
            <tr>
                <td class="identity-cell">
                    {% set fullName = adherant.prenom ~ ' ' ~ (adherant.nom|upper) %}
                    <div class="name{{ fullName|length > 30 ? ' name-long' }}">{{ fullName }}</div>
                    <div class="member-since">Adh&eacute;rent depuis {{ adherant.createdAt|date('Y') }}</div>

                    <div class="field-label">Code adh&eacute;rent</div>
                    <div class="field-value">{{ adherant.code }}</div>

                    <div class="validity">
                        {% if adhesion %}
                            Valide du <strong>{{ adhesion.dateDebut|date('d/m/Y') }}</strong>
                            au <strong>{{ adhesion.dateFin|date('d/m/Y') }}</strong>
                        {% else %}
                            Aucune adh&eacute;sion active
                        {% endif %}
                    </div>
                </td>
                <td class="qr-cell">
                    <div class="qr-box">
                        <img src="{{ qrCodeDataUri }}" alt="QR Code">
                    </div>
                    <div class="qr-caption">Scannez pour v&eacute;rifier la validit&eacute;</div>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
